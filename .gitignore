# Kredensial — JANGAN PERNAH di-commit
backend/app/credentials.json
backend/credentials.json
credentials.json

# Database — biarkan tetap di server, jangan ikut ke git (berisi data asli toko)
backend/app/mugen_hair.db
*.db

# TAHAP 10: file logo yang diupload & backup database — spesifik per instalasi,
# jangan ikut ke git (folder tetap dipertahankan lewat .gitkeep)
backend/app/static/logo/*
!backend/app/static/logo/.gitkeep
# BOOKING: file QRIS yang diupload — sama seperti logo di atas
backend/app/static/qris/*
!backend/app/static/qris/.gitkeep
# PENYEMPURNAAN FORM BOOKING: foto barber yang diupload — sama seperti logo/QRIS
backend/app/static/barber_foto/*
!backend/app/static/barber_foto/.gitkeep
# Website Content: Hero Image, Hero Video, Foto About, Gallery, Background Website
# — sama seperti logo/QRIS di atas. Banner (Setting > Identitas) DIHAPUS
# (dipindah jadi Hero Image di sini, lihat REVISI STRUKTUR WEBSITE CONTENT).
backend/app/static/hero_image/*
!backend/app/static/hero_image/.gitkeep
backend/app/static/hero_video/*
!backend/app/static/hero_video/.gitkeep
backend/app/static/about/*
!backend/app/static/about/.gitkeep
backend/app/static/gallery/*
!backend/app/static/gallery/.gitkeep
backend/app/static/background/*
!backend/app/static/background/.gitkeep
# Modul Karyawan Fase 4 (Reimburse): file bukti klaim yang diupload — sama
# seperti logo/QRIS/foto barber di atas.
backend/app/static/reimburse_bukti/*
!backend/app/static/reimburse_bukti/.gitkeep
backend/app/backups/

# Python
__pycache__/
*.pyc
.venv/
venv/

# android-app/ (proyek Capacitor) — node_modules dibuat ulang via `npm install`
# (lihat android-app/README.md), .gradle/build sudah di-cover android-app/android/.gitignore
node_modules/

# frontend/ suite E2E Playwright (lihat frontend/e2e/, frontend/playwright.config.js)
# — output tes lokal, dibuat ulang tiap `npm run test:e2e`, TIDAK ikut git.
frontend/playwright-report/
frontend/test-results/

# Editor
.vscode/
.idea/
.DS_Store
